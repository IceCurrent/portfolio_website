---
import BaseLayout from './BaseLayout.astro';
import IconGitHub from '../components/icons/IconGitHub.astro';
import '../styles/article.css';

export interface Props {
  /** `<title>` / OG; can include site or author for SEO. */
  title: string;
  /** Visible `<h1>`; omit to use `title`. */
  headline?: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  collectionLabel: 'PROJECT' | 'WRITING';
  eyebrow?: string;
  summary?: string;
  meta?: {
    dateRange?: string;
    tags?: string[];
    github?: string;
    author?: string;
    readingTimeMinutes?: number;
  };
  hero?: {
    src: string;
    alt: string;
  };
}

const {
  title,
  headline,
  description,
  ogImage = '/og-default.svg',
  noindex = false,
  collectionLabel,
  eyebrow = collectionLabel,
  summary,
  meta,
  hero,
} = Astro.props;

const displayTitle = headline ?? title;
const tagsJoined = meta?.tags?.join(' · ');
const isProject = collectionLabel === 'PROJECT';
const projectSkillLine =
  isProject && meta?.tags?.length ? meta.tags.map((tag) => tag.toUpperCase()).join(' · ') : '';

const bylineParts: string[] = [];
if (meta?.author?.trim()) {
  bylineParts.push(`AUTHOR · ${meta.author.trim().toUpperCase()}`);
}
if (meta?.readingTimeMinutes != null) {
  bylineParts.push(`${meta.readingTimeMinutes} MIN READ`);
}
const byline = bylineParts.join(' · ');
---

<BaseLayout title={title} description={description} ogImage={ogImage} noindex={noindex}>
  <article class="article-page">
    <header class="article-page__header section">
      <div class="container">
        <div class="article-page__column">
          <p class="eyebrow">{eyebrow}</p>
          <h1 class="article-page__title">{displayTitle}</h1>
          {summary && <p class="article-page__summary">{summary}</p>}
          {byline ? <p class="article-page__byline eyebrow">{byline}</p> : null}
          {projectSkillLine ? (
            <p class="article-page__skill-tags eyebrow">{projectSkillLine}</p>
          ) : null}
          {
            meta && (
              <div class="article-page__meta">
                {meta.dateRange && <span class="article-page__meta-date">{meta.dateRange}</span>}
                {!isProject && tagsJoined ? (
                  <span class="article-page__meta-tags">{tagsJoined}</span>
                ) : null}
                {meta.github && (
                  <a
                    href={meta.github}
                    class="article-page__meta-github"
                    aria-label="View repository on GitHub"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <IconGitHub size={16} />
                  </a>
                )}
              </div>
            )
          }
        </div>
      </div>
    </header>

    {
      hero && (
        <div class="article-page__hero">
          <div class="container">
            <figure class="article-page__hero-figure">
              <img
                class="article-page__hero-img"
                src={hero.src}
                alt={hero.alt}
                width="1600"
                height="900"
                loading="eager"
              />
            </figure>
          </div>
        </div>
      )
    }

    <div class="section article-page__body-wrap">
      <div class="container">
        <div class="article-page__column">
          <div class="article-body">
            <slot />
          </div>
        </div>
      </div>
    </div>

    <footer class="article-page__footer section">
      <div class="container">
        <hr class="hairline article-page__hr" />
        <div class="article-page__nav" role="navigation" aria-label="Article navigation">
          <slot name="article-nav" />
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>

<style>
  /* Tighter tail under masthead — closer to Medium rhythm before hero/body */
  .article-page__header.section {
    padding-block-end: var(--s-5);
  }

  @media (min-width: 1024px) {
    .article-page__header.section {
      padding-block-end: var(--s-6);
    }
  }

  .article-page__title {
    margin-top: var(--s-3);
    text-wrap: balance;
  }

  .article-page__summary {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    color: var(--c-muted);
    line-height: var(--lh-body);
    margin-top: var(--s-4);
  }

  .article-page__byline {
    margin-top: var(--s-3);
    color: var(--c-muted);
    text-align: left;
  }

  .article-page__skill-tags {
    margin-top: var(--s-3);
    color: var(--c-muted);
    text-align: left;
    text-wrap: pretty;
  }

  .article-page__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    width: 100%;
    margin-top: var(--s-4);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--c-muted);
    text-align: left;
  }

  .article-page__meta-tags {
    flex: 1 1 auto;
    min-width: 12ch;
  }

  .article-page__meta-github {
    margin-left: auto;
    color: var(--c-charcoal);
    display: inline-flex;
    flex-shrink: 0;
    transition: color 160ms ease;
  }

  .article-page__meta-github:hover,
  .article-page__meta-github:focus-visible {
    color: var(--c-bright-blue);
  }

  .article-page__hero {
    padding-block: var(--s-4);
  }

  @media (min-width: 768px) {
    .article-page__hero {
      padding-block: var(--s-5);
    }
  }

  .article-page__hero-figure {
    width: 100%;
    max-width: var(--measure-prose);
    margin: 0 auto;
  }

  .article-page__hero-img {
    width: 100%;
    height: auto;
    display: block;
    background: var(--c-light-gray);
  }

  .article-page__body-wrap {
    padding-block-start: var(--s-5);
  }

  @media (min-width: 768px) {
    .article-page__body-wrap {
      padding-block-start: var(--s-6);
    }
  }

  .article-page__hr {
    margin-block-end: var(--s-5);
  }

  .article-page__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    justify-content: space-between;
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
  }

  .article-page__nav a {
    color: var(--c-charcoal);
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: var(--c-mid-gray);
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .article-page__nav a:hover,
  .article-page__nav a:focus-visible {
    color: var(--c-bright-blue);
    text-decoration-color: var(--c-bright-blue);
  }
</style>
