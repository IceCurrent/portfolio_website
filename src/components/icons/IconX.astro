---
export interface Props {
  size?: number;
  title?: string;
}
const { size = 20, title } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
>
  {title && <title>{title}</title>}
  <path d="M18.244 2H21.5l-7.4 8.46L23 22h-6.84l-5.36-7.01L4.62 22H1.36l7.92-9.05L1 2h7.01l4.84 6.4L18.244 2Zm-1.2 18h1.9L7.05 4H5.04l11.999 16Z" />
</svg>
