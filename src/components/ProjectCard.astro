---
import IconGitHub from './icons/IconGitHub.astro';
import { projectHeroSrc } from '../lib/projectHero';

export interface Props {
  slug: string;
  title: string;
  summary: string;
  tags: string[];
  dateRange: string;
  heroAlt: string;
}

const { slug, title, summary, tags, dateRange, heroAlt } = Astro.props;
const href = `/projects/${slug}`;
const tagLine = tags.join(' · ');
---

<a href={href} class="project-card">
  <div class="project-card__media">
    <img
      src={projectHeroSrc(slug)}
      alt={heroAlt}
      width="1600"
      height="900"
      loading="lazy"
      class="project-card__img"
    />
  </div>
  <div class="project-card__body">
    <p class="project-card__tags eyebrow">{tagLine}</p>
    <h2 class="project-card__title">{title}</h2>
    <p class="project-card__summary">{summary}</p>
    <div class="project-card__meta">
      <span class="project-card__date">{dateRange}</span>
      <span class="project-card__gh" aria-hidden="true">
        <IconGitHub size={16} />
      </span>
    </div>
  </div>
</a>

<style>
  .project-card {
    display: block;
    border-top: var(--bw) solid var(--c-mid-gray);
    padding-top: 0;
    color: inherit;
    text-decoration: none;
  }

  .project-card__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--c-light-gray);
  }

  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: filter 200ms ease;
  }

  .project-card:hover .project-card__img,
  .project-card:focus-visible .project-card__img {
    filter: brightness(0.95);
  }

  .project-card__body {
    padding-block-start: var(--s-4);
  }

  .project-card__tags {
    margin-bottom: var(--s-2);
    color: var(--c-muted);
  }

  .project-card__title {
    font-family: var(--ff-serif);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--c-charcoal);
    line-height: var(--lh-snug);
    transition: color 160ms ease;
  }

  .project-card:hover .project-card__title,
  .project-card:focus-visible .project-card__title {
    color: var(--c-bright-blue);
  }

  .project-card__summary {
    font-family: var(--ff-sans);
    font-size: var(--fs-base);
    line-height: 1.5;
    color: var(--c-charcoal);
    margin-top: var(--s-3);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--s-4);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }

  .project-card__gh {
    color: var(--c-charcoal);
    transition: color 160ms ease;
    display: inline-flex;
  }

  .project-card:hover .project-card__gh,
  .project-card:focus-visible .project-card__gh {
    color: var(--c-bright-blue);
  }
</style>
